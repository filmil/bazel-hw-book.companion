# Chapter 1 claims that Bazel derives the compile order from the graph.
# The deps edge below is the only statement that util must be analyzed
# first. Delete it and the build fails at once: the GHDL command gets no
# -P path to the util library, so GHDL cannot find the package.
load("@bazel_rules_ghdl//:rules.bzl", "ghdl_library", "ghdl_verilog")

package(default_visibility = ["//visibility:public"])

ghdl_library(
    name = "counter_pkg_lib",
    srcs = ["counter_pkg.vhd"],
    deps = ["//design/util"],
)

ghdl_verilog(
    name = "counter_pkg_v",
    lib = ":counter_pkg_lib",
    unit = "counter_pkg",
)
