"""The companion workspace for "Hardware Development with Bazel".

Each target here is a listing from the book, buildable as printed. The
chapter directories hold BUILD files and their sources, so a listing on
the page and a file in this repository can be compared line by line.

Versions are the ones the hdlfactory registry actually serves. To check:

    curl -s https://raw.githubusercontent.com/filmil/bazel-registry/main/\
      modules/rules_ghdl/metadata.json | jq -r .versions[]
"""

module(
    name = "hdl_bazel_book_examples",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

# The VHDL toolchain of the Chapter 1 tour. rules_ghdl 1.2.0 is the last
# release with the ghdl_library and ghdl_verilog API the book prints;
# 1.2.1 moved to ghdl_analyze and rules_vhdl. It builds GHDL from Ada
# source through the BCR `ghdl` module, so nothing needs installing.
#
# The book loads it as @bazel_rules_ghdl, the ruleset's name before the
# registry rename (Appendix E). repo_name keeps those load statements
# working as printed.
bazel_dep(name = "rules_ghdl", version = "1.2.0", repo_name = "bazel_rules_ghdl")

# Simulation and tests with NVC, for Chapters 3, 8, 11 and 19. rules_nvc
# builds NVC from C source through the `nvc` module of the hdlfactory
# registry. That build needs a C compiler on the host.
bazel_dep(name = "rules_nvc", version = "4.5.2")

# Self-extracting archives, for the Chapter 11 demo. 1.0.7 is the version
# Appendix E names.
bazel_dep(name = "rules_shar", version = "1.0.7")

# sh_test, for the Chapter 11 demo test.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The constraint values of the Chapter 13 platform.
bazel_dep(name = "platforms", version = "1.1.0")

# The vhdl_ls aspect of Chapters 9 and 18. 0.3.1 is the version Appendix E
# names.
bazel_dep(name = "vhdl_ls_gen", version = "0.3.1")

# unittest.bzl and bzl_library, for the tests of Chapters 10 and 19.
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# The stardoc golden of Chapter 19. These two lines are the MODULE.bazel
# part of the Chapter 5 listing, as printed.
bazel_dep(name = "stardoc", version = "0.8.1",
          dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.3.1",
          dev_dependency = True)

# The use_extension and use_repo lines of Chapter 16 for a module that
# declares its own extension. The book's module keeps the file at
# //internal/toolchain:extensions.bzl; here it is in ch16. The listing
# also activates a qemu extension, which the chapter does not print, so
# those lines are left out.
riscv_toolchain = use_extension(
    "//ch16:extensions.bzl",
    "riscv_toolchain")
use_repo(riscv_toolchain, "opensbi_riscv_toolchain")
