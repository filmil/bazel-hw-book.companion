# Chapter 1, "A tour of a real HDL ruleset". Everything below this
# comment is the listing from that page, unabridged: two rules, and Bazel
# knows the dependency between them.
#
# The book builds this as //core:counter_v in one place and //:counter_v
# in another. Here it is //ch01:counter_v.
load("@bazel_rules_ghdl//:rules.bzl",
     "ghdl_library", "ghdl_verilog")

ghdl_library(
    name = "counter_lib",
    srcs = ["counter.vhd"],
)

ghdl_verilog(
    name = "counter_v",
    lib = ":counter_lib",
    unit = "counter",
)
