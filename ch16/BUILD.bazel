# Chapter 16, "Module extensions". extensions.bzl is the chapter's
# riscv_toolchain extension, as printed. MODULE.bazel activates it, and
# the rules_kconfig extension, with the chapter's use_extension and
# use_repo lines; see the comments there.
#
# The targets below are not in the book. They check what the two
# extensions created.
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Kconfig"])

# The GCC from the riscv_toolchain extension compiles a freestanding C
# function, and the test checks that the result is a RISC-V object file.

genrule(
    name = "hello_o",
    srcs = ["hello.c"],
    outs = ["hello.o"],
    cmd = "$(execpath @opensbi_riscv_toolchain//:gcc) " +
          "-ffreestanding -nostdlib -O2 -c $< -o $@",
    tools = [
        "@opensbi_riscv_toolchain//:all",
        "@opensbi_riscv_toolchain//:gcc",
    ],
)

sh_test(
    name = "riscv_elf_test",
    size = "small",
    srcs = ["riscv_elf_test.sh"],
    args = ["$(rootpath :hello_o)"],
    data = [":hello_o"],
)

# The grlib_config repository from the kconfig extension provides
# config.h. The test checks that it holds the Kconfig defaults.
cc_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.c"],
    deps = ["@grlib_config//:config"],
)
